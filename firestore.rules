rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidLead() {
      let data = request.resource.data;
      // Поддерживаем старый формат (name, contact) и новый из Lead Finder (businessName, phone)
      let hasOldFormat = ('name' in data) && data.name is string && data.name.size() > 0 &&
                         ('contact' in data) && data.contact is string && data.contact.size() > 0;
                         
      let hasNewFormat = ('businessName' in data) && data.businessName is string && data.businessName.size() > 0 &&
                         ('phone' in data) && data.phone is string && data.phone.size() > 0;
                         
      return data.size() >= 2 && (hasOldFormat || hasNewFormat);
    }

    match /leads/{leadId} {
      // ВНИМАНИЕ: Для тестирования админки по PIN-коду открываем доступ. 
      // В продакшене лучше настроить полноценный Firebase Auth и вернуть проверку isAdmin().
      allow read: if true; 
      allow update, delete: if true;
      allow create: if isValidLead();
    }
  }
}
